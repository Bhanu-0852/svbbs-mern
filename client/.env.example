# Leave VITE_API_URL unset for normal local dev — the client then calls the
# relative path /api, which Vite's dev server proxies to the backend on
# port 5000 (see vite.config.js). This keeps every request same-origin in
# the browser, which is what login/session cookies rely on; this is also
# the exact setup used throughout development and testing.
#
# Only set this if you're running the client and server on genuinely
# different machines/hosts (not just different ports on localhost) — and
# if you do, make sure CLIENT_URL in server/.env matches the client's
# real origin, since the server's CORS check requires an exact match.
VITE_API_URL=
